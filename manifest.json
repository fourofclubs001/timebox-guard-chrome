{
  "manifest_version": 3,
  "name": "Timebox Guard",
  "version": "1.0.0",
  "description": "Asks how long and why before you open the sites you choose to limit, and blocks them again when that time is up.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Timebox Guard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "settings.html",
  "permissions": ["storage", "tabs", "webNavigation", "alarms", "idle"]
}
